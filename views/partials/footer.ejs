  <script>
    // Dark mode is handled by /js/app.js (data-theme on <html>).
    (function () {
      // Mobile nav toggle
      var navToggle = document.getElementById('nav-toggle');
      var navLinks = document.getElementById('nav-links');
      if (navToggle && navLinks) {
        navToggle.addEventListener('click', function () {
          var open = navLinks.classList.toggle('open');
          navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      }
    })();

    // Save / unsave a paper (used by paper-view and subject-detail pages)
    async function toggleSavePaper(paperId, btn) {
      var saved = btn.getAttribute('data-saved') === '1';
      btn.disabled = true;
      try {
        var res = await fetch('/api/save-paper/' + encodeURIComponent(paperId), {
          method: saved ? 'DELETE' : 'POST',
          headers: { 'Accept': 'application/json' }
        });
        if (res.status === 401) {
          window.location.href = '/login?next=' + encodeURIComponent(window.location.pathname);
          return;
        }
        if (!res.ok) throw new Error('Request failed');
        btn.setAttribute('data-saved', saved ? '0' : '1');
        btn.textContent = saved ? 'Save' : 'Saved ✓';
        btn.classList.toggle('btn-primary', !saved);
      } catch (e) {
        alert('Could not update your saved papers. Please try again.');
      } finally {
        btn.disabled = false;
      }
    }
  </script>
